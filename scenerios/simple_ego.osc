
import basic.osc

scenario top:
    path: Path
    path.set_map("Town04")
    path.path_min_driving_lanes(2)

    ego_vehicle: Ego
    npc: Model3

    event start

    do parallel:
        ego_vehicle.drive(path) with:
            lane(1, at: start)
            speed(0kph)

        npc.drive(path) with:
            position(20m, ahead_of: ego_vehicle, at: start)
            speed(0kph)

        wait elapsed(80s)
